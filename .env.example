# Sentinel LLM Gateway Configuration
# Copy this file to .env and customize for your environment.

SENTINEL_ENVIRONMENT=development
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000

# Active provider: local-demo | ollama | gemini | openai
SENTINEL_PROVIDER=local-demo
SENTINEL_MODEL=sentinel-demo-v1
SENTINEL_PROVIDER_TIMEOUT_SECONDS=30.0
SENTINEL_FALLBACK_TO_LOCAL_DEMO=true

# Ollama (Local LLM)
SENTINEL_OLLAMA_BASE_URL=http://localhost:11434
SENTINEL_OLLAMA_MODEL=qwen2.5:7b

# Google Gemini
SENTINEL_GEMINI_API_KEY=
SENTINEL_GEMINI_MODEL=gemini-2.0-flash

# OpenAI / OpenAI-compatible upstream
SENTINEL_OPENAI_API_KEY=
SENTINEL_OPENAI_BASE_URL=https://api.openai.com/v1
SENTINEL_OPENAI_MODEL=gpt-4o-mini

# Security Guardrails & PII Policy
# policy_mode: block | redact | warn | allow
SENTINEL_POLICY_MODE=block
SENTINEL_INJECTION_BLOCK_THRESHOLD=0.65
SENTINEL_INJECTION_WARN_THRESHOLD=0.35
SENTINEL_TOXICITY_BLOCK_THRESHOLD=0.60
SENTINEL_ENABLE_PII_REDACTION=true
SENTINEL_RESTORE_PII_BY_DEFAULT=false

# Semantic Cache
SENTINEL_ENABLE_SEMANTIC_CACHE=true
SENTINEL_CACHE_SIMILARITY_THRESHOLD=0.86
SENTINEL_CACHE_TTL_SECONDS=3600
SENTINEL_CACHE_MAX_ENTRIES=2000

# Persistence & Rate Limiting
SENTINEL_DB_PATH=data/sentinel_gateway.db
SENTINEL_RATE_LIMIT_RPM=120
